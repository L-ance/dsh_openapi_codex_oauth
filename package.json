{
  "name": "dsh-openapi-codex-oauth",
  "version": "0.2.0",
  "description": "DeepSeek Harness LLM provider backed by Codex App Server and managed ChatGPT OAuth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L-ance/dsh_openapi_codex_oauth.git"
  },
  "homepage": "https://github.com/L-ance/dsh_openapi_codex_oauth#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-openapi-codex-oauth": "lib/installer.js",
    "dsh-codex-login": "lib/login.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.client.config.ts",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test && npm pack --dry-run",
    "plugin:install": "npm run build && dsh plugin --profile web add .",
    "plugin:remove": "dsh plugin --profile web remove dsh-openapi-codex-oauth"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "chatgpt",
    "codex",
    "oauth",
    "llm-provider"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@openai/codex": "0.150.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.24",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  }
}
